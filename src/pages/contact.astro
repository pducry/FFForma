---
import Base from '../layouts/Base.astro';
const description = 'Contact Forma. Book a call. No email address is published on this page.';
---
<Base title="Contact — Forma" description={description} now="Contact" nowKey="contact.h">
  <article class="page">
    <h1 data-i18n="contact.h">Contact</h1>
    <p data-i18n="contact.p">Book a call. No email address is published here.</p>
    <p>
      <a href="#" data-cal-link="pedro-julien" data-cal-config='{"layout":"month_view"}' data-i18n="contact.book">Book a call</a>
    </p>
  </article>
  <script is:inline src="/js/cal.js"></script>
</Base>
