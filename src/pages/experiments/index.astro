---
import Base from '../../layouts/Base.astro';
import { experiments, experimentTags } from '../../data/experiments';
const description = 'Forma experiments: six interactive pieces already on the site, dated and tagged.';
const blurbs: Record<string, string> = {
  'exp.001': 'A radial share dial with spring physics, sector highlights and rotary drag.',
  'exp.002': 'Words light up as you read. The edge is the cursor.',
  'exp.003': 'A liquid glass lens over old landscapes, with every parameter on a slider.',
  'exp.004': 'An AI thinking orb, fully parametric, with CSS and React output.',
  'exp.005': 'Avatars with a magnetic field: spring physics, parallax depth, and a polarity switch.',
  'exp.006': 'An infinite gallery that bends with your scroll velocity.',
};
---
<Base title="Experiments — Forma" description={description}>
  <h1 class="page-title" data-i18n="exp.h">Experiments</h1>
  <p class="lead measure" data-i18n="exp.lead">Six pieces already on the site, dated the day they were added to the repo.</p>
  <div class="lab-tools" id="tagbar">
    <button class="tag-btn is-on" type="button" data-tag="all" data-i18n="exp.all">All</button>
    {experimentTags.map((tag) => (
      <button class="tag-btn" type="button" data-tag={tag} data-i18n={`tag.${tag}`}>{tag}</button>
    ))}
  </div>
  <div>
    {experiments.map((item) => (
      <article class="lab-item" data-tags={item.tags.join(' ')}>
        <span class="lab-num">{item.num}</span>
        <a class="lab-title" href={`/experiments/${item.slug}/`}>{item.title}</a>
        <time class="lab-date" datetime={item.date}>{item.date}</time>
        <p class="lab-blurb" data-i18n={item.blurbKey}>{blurbs[item.blurbKey]}</p>
        <p class="lab-tags">
          {item.tags.map((tag, index) => (
            <>
              {index > 0 && ' · '}
              <span data-i18n={`tag.${tag}`}>{tag}</span>
            </>
          ))}
        </p>
      </article>
    ))}
  </div>
</Base>
