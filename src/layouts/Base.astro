---
import '../styles/site.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  /** Right-hand header label when the page is not the home scroll. */
  now?: string;
  nowKey?: string;
}

const { title, description, image = '/img/og.jpg', now = '', nowKey = '' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = new URL(image, Astro.site);
const ogSized = image === '/img/og.jpg';
const en = new URL(canonical);
const pt = new URL(canonical);
en.searchParams.set('lang', 'en');
pt.searchParams.set('lang', 'pt');
const path = Astro.url.pathname;
const indexOn = path === '/';
const researchOn = path.startsWith('/research') || path.startsWith('/experiments');
const infoOn = path.startsWith('/information') || path.startsWith('/info');
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical.href}>
  <link rel="alternate" hreflang="en" href={en.href}>
  <link rel="alternate" hreflang="pt-BR" href={pt.href}>
  <link rel="alternate" hreflang="x-default" href={canonical.href}>
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Forma">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical.href}>
  <meta property="og:image" content={og.href}>
  {ogSized && <meta property="og:image:width" content="1200">}
  {ogSized && <meta property="og:image:height" content="630">}
  <meta property="og:locale" content="en_US">
  <meta property="og:locale:alternate" content="pt_BR">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={og.href}>
  <meta name="theme-color" content="#ffffff">
  <link rel="icon" type="image/png" href="/img/favicon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Geist+Mono&family=Inter:wght@400&display=swap" rel="stylesheet">
</head>
<body>
  <header class="top">
    <div class="top-left">
      <a class="brand" href="/">
        <img src="/img/favicon.png" alt="">
        <span>Forma</span>
      </a>
    </div>
    <nav class="top-center" aria-label="Sections">
      <a class="nav-link" href="/" data-i18n="nav.index" aria-current={indexOn ? 'page' : undefined}>Index</a>
      <a class="nav-link" href="/research/" data-i18n="nav.research" aria-current={researchOn ? 'page' : undefined}>Research</a>
      <a class="nav-link" href="/information/" data-i18n="nav.information" aria-current={infoOn ? 'page' : undefined}>Information</a>
    </nav>
    <div class="top-right">
      <p class="now" id="nowLabel" data-i18n={nowKey || undefined}>{now}</p>
    </div>
  </header>
  <main>
    <slot />
  </main>
  <footer class="foot">
    <div class="foot-left">
      <span data-i18n="footer.copy">© 2026 Forma</span>
      <span class="clock"><span class="dot" aria-hidden="true"></span><span data-clock>--:--:--</span></span>
    </div>
    <div class="foot-center">
      <a href="/inquire/" data-i18n="footer.inquire">Inquire</a>
    </div>
    <div class="foot-right">
      <span class="lang" role="group" aria-label="Language">
        <button class="lang-btn" type="button" data-lang="en">EN</button>
        <span aria-hidden="true">/</span>
        <button class="lang-btn" type="button" data-lang="pt">PT</button>
      </span>
      <a href="/legal/" data-i18n="footer.legal">Legal</a>
      <a href="/contact/" data-i18n="footer.contact">Contact</a>
    </div>
  </footer>
  <script is:inline src="/js/site.js"></script>
</body>
</html>
