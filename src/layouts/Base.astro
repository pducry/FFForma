---
import '../styles/site.css';
import Nav from '../components/Nav.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
}

const { title, description, image = '/img/og.jpg' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = new URL(image, Astro.site);
const ogSized = image === '/img/og.jpg';
const en = new URL(canonical);
const pt = new URL(canonical);
en.searchParams.set('lang', 'en');
pt.searchParams.set('lang', 'pt');
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical.href}>
  <link rel="alternate" hreflang="en" href={en.href}>
  <link rel="alternate" hreflang="pt-BR" href={pt.href}>
  <link rel="alternate" hreflang="x-default" href={canonical.href}>
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Forma">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical.href}>
  <meta property="og:image" content={og.href}>
  {ogSized && <meta property="og:image:width" content="1200">}
  {ogSized && <meta property="og:image:height" content="630">}
  <meta property="og:locale" content="en_US">
  <meta property="og:locale:alternate" content="pt_BR">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={og.href}>
  <meta name="theme-color" content="#0b0a09">
  <link rel="icon" type="image/png" href="/img/favicon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet">
  <script is:inline>
    try {
      if (localStorage.getItem('ffforma-theme') === 'light') {
        document.documentElement.dataset.theme = 'light';
      }
    } catch (e) {}
  </script>
</head>
<body>
  <div class="wrap">
    <Nav />
    <slot />
    <footer class="site-foot">
      <span data-i18n="footer.line">Form Follows Function.</span>
      <div class="footer-meta" data-i18n="footer.meta">© 2026 Forma.</div>
    </footer>
  </div>
  <slot name="bleed" />
  <script is:inline src="/js/site.js"></script>
</body>
</html>
