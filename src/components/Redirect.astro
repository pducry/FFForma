---
interface Props {
  to: string;
}
const { to } = Astro.props;
const canonical = new URL(to, Astro.site);
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="robots" content="noindex">
  <link rel="canonical" href={canonical.href}>
  <meta http-equiv="refresh" content={`0;url=${to}`}>
  <title>Forma</title>
</head>
<body>
  <p><a href={to}>Forma</a></p>
  <script is:inline define:vars={{ to }}>location.replace(to);</script>
</body>
</html>
